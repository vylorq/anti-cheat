{
  "schemaVersion": 1,
  "id": "vigil",
  "provides": [
    "anticheat"
  ],
  "version": "${version}",
  "name": "Vigil",
  "description": "Anti-cheat and server protection that keeps watch through the night.",
  "authors": [
    "vylorq"
  ],
  "contact": {
    "sources": "https://github.com/vylorq/anti-cheat"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/vigil/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.vylorq.anticheat.AntiCheatMod"
    ],
    "fabric-gametest": [
      "com.vylorq.anticheat.gametest.AntiCheatGameTests"
    ]
